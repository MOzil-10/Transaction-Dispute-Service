# Copy this file to deploy/.env on the server and fill in real values.
# deploy/.env is gitignored and must NEVER be committed.

# Public hostname pointed at the EC2 Elastic IP. Caddy auto-provisions a Let's Encrypt
# certificate for it. This demo uses a free DuckDNS subdomain (set the IP in the DuckDNS
# dashboard - see deploy/README.md Step 5). Example: disputex-demo.duckdns.org
DOMAIN=your-subdomain.duckdns.org

# JWT signing key - MUST be at least 32 bytes (256 bits). Generate a fresh random
# value on the server, do NOT reuse the local demo key. For example:
#   openssl rand -hex 48
JWT_SECRET_KEY=replace-with-a-freshly-generated-48-byte-hex-string

# PostgreSQL password for the demo database (any strong value, e.g. openssl rand -hex 16).
DB_PASSWORD=replace-with-a-strong-password

# ---- Amazon SQS (real managed queue) --------------------------------------------------
# The deployed stack publishes dispute events to a REAL Amazon SQS FIFO queue.
# AWS credentials are NOT set here - they are provided by the EC2 instance role, so the
# only SQS config needed is the region and the queue URL.

AWS_REGION=af-south-1

# Full URL of the FIFO queue created in Step (SQS) of the runbook, e.g.
#   https://sqs.af-south-1.amazonaws.com/123456789012/dispute-events.fifo
AWS_SQS_DISPUTE_QUEUE_URL=https://sqs.af-south-1.amazonaws.com/<account-id>/dispute-events.fifo