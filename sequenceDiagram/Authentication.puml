@startuml
autonumber
skinparam Style strictuml
skinparam SequenceMessageAlignment center
skinparam boxPadding 10

box "User Layer" #E6F0FA
actor "Customer\n(Rita)" as Customer
end box

box "Frontend Layer" #E6F9E6
participant "Angular Frontend\n(Web App)" as Frontend
end box

box "API & Service Layer" #FFF9E6
participant "AuthController" as Controller
participant "AuthService" as Service
participant "AuthenticationManager\n(Spring Security)" as AuthManager
participant "UserRepository" as UserRepo
participant "UserDetailsService" as UDS
participant "JwtService" as JWT
end box

box "Database Layer" #F2E6FF
database "PostgreSQL\n(RDS Database)" as DB
end box

Customer -> Frontend: Log in (email + password)
Frontend -> Controller: POST /api/v1/auth/login\n(LoginRequestDto)

Controller -> Service: login(request)
Service -> AuthManager: authenticate(\nUsernamePasswordAuthenticationToken)
AuthManager -> UDS: loadUserByUsername(email)
UDS -> DB: SELECT ... FROM customers WHERE email = ?
DB --> UDS: UserEntity (passwordHash)
UDS --> AuthManager: UserDetails

alt #LightPink Invalid Credentials
    AuthManager --> Service: throw BadCredentialsException
    Service --> Controller: throw UnauthorizedException\n(MSG_INVALID_CREDENTIALS)
    Controller --> Frontend: <font color=red><b>401 Unauthorized</b> (ErrorResponseDto)</font>
    Frontend --> Customer: Show login error
else #LightGreen Credentials Valid
    AuthManager --> Service: Authentication successful

    Service -> UserRepo: findByEmail(request.email())
    UserRepo -> DB: SELECT ... FROM customers WHERE email = ?
    DB --> UserRepo: UserEntity
    UserRepo --> Service: UserEntity

    Service -> UDS: loadUserByUsername(user.getEmail())
    UDS --> Service: UserDetails
    Service -> JWT: generateToken(userDetails, customerId)
    JWT --> Service: Bearer JWT (customerId claim)

    Service --> Controller: AuthResponseDto\n(token, customerId, email)
    Controller --> Frontend: <font color=green><b>200 OK</b> (AuthResponseDto)</font>
    Frontend --> Customer: Login successful (redirect to dashboard)
end
@enduml
