@startuml
title Submit a Dispute
autonumber
skinparam Style strictuml
skinparam SequenceMessageAlignment center
skinparam boxPadding 10

box "User" #E6F0FA
actor "Customer" as Customer
end box

box "Client" #E6F9E6
participant "DisputeX Web App" as Frontend
end box

box "DisputeX Backend" #FFF9E6
participant "Auth Filter" as Filter
participant "DisputeX API" as Api
participant "Dispute Service" as Service
participant "Risk Engine" as RiskEngine
participant "Decision Matrix" as Decision
participant "Event Publisher" as Publisher
end box

box "Data" #F2E6FF
database "Customer Store" as CustomerDB
database "Transaction Store" as TxnDB
database "Account Store" as AccountDB
database "Dispute Store" as DisputeDB
queue "Message Queue" as Queue
end box

Customer -> Frontend: Select a transaction and give a reason
Frontend -> Filter: Submit dispute request\n(with access token)

Filter -> Filter: Verify access token
alt #LightPink Token invalid or missing
    Filter --> Frontend: Session expired
    Frontend --> Customer: Prompt to log in
else #LightGreen Token valid
    Filter -> Api: Forward authenticated request
    Api -> Service: Submit dispute for customer

    Service -> CustomerDB: Load customer
    CustomerDB --> Service: Customer
    Service -> TxnDB: Load transaction
    TxnDB --> Service: Transaction

    alt #LightPink Transaction not owned by customer
        Service --> Api: Access to transaction denied
        Api --> Frontend: Dispute refused (not your transaction)
        Frontend --> Customer: Show error message
    else #LightPink Outside 60-day dispute window
        Service -> Service: Check dispute window\n(transaction older than 60 days)
        Service --> Api: Dispute window closed
        Api --> Frontend: Dispute refused (too old to dispute)
        Frontend --> Customer: Show error message
    else #LightPink Transaction category not disputable
        Service -> Service: Check category eligibility
        Service --> Api: Category cannot be disputed
        Api --> Frontend: Dispute refused (not eligible)
        Frontend --> Customer: Show error message
    else #LightPink Dispute already lodged
        Service -> DisputeDB: Check for existing dispute on transaction
        DisputeDB --> Service: Dispute already exists
        Service --> Api: Duplicate dispute
        Api --> Frontend: Dispute refused (already lodged)
        Frontend --> Customer: Show existing dispute
    else #LightGreen Valid and eligible
        Service -> RiskEngine: Score the dispute\n(mandate type + reason)
        RiskEngine --> Service: Risk score (0-100)
        Service -> Decision: Route by risk score
        Decision --> Service: Auto-approve (low risk)\nor Manual investigation (higher risk)

        Service -> DisputeDB: Record dispute\n(status set from routing decision)
        DisputeDB --> Service: Saved dispute (reference)

        opt Auto-approved
            Service -> AccountDB: Credit refund to account\n(atomic with the dispute)
            AccountDB --> Service: Updated balance
        end

        Service -> Publisher: Publish dispute event
        Publisher -> Queue: Enqueue dispute event
        Queue --> Publisher: Accepted (message id)
        note right of Publisher
          Queue delivery is non-blocking:
          if it fails, the dispute is still
          saved and the customer still gets
          a response.
        end note
        Publisher --> Service: Message id
        Service -> DisputeDB: Attach message id for audit

        Service --> Api: Dispute outcome\n(reference, status, refunded amount, message)
        Api --> Frontend: Dispute created
        Frontend --> Customer: Show confirmation and outcome
    end
end
@enduml