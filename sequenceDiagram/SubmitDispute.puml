@startuml
autonumber
skinparam Style strictuml
skinparam SequenceMessageAlignment center
skinparam boxPadding 10

box "User Layer" #E6F0FA
actor "Customer\n(Rita)" as Customer
end box

box "Frontend Layer" #E6F9E6
participant "Angular Frontend\n(Web App)" as Frontend
end box

box "Security & API Layer" #FFF9E6
participant "JwtAuthenticationFilter" as Filter
participant "DisputeController" as Controller
participant "JwtService" as JWT
participant "DisputeService" as Service
end box

box "Persistence & Engines" #FFE6E6
participant "UserRepository" as UserRepo
participant "TransactionRepository" as TxnRepo
participant "DisputeRepository" as DisputeRepo
participant "RiskScoreEngine" as RiskEngine
participant "DecisionMatrix" as DecisionMatrix
participant "SqsPublisherService" as SqsPublisher
end box

box "Infrastructure" #F2E6FF
database "PostgreSQL\n(Database)" as DB
queue "AWS SQS\n(dispute-events.fifo)" as SQS
end box

Customer -> Frontend: Select transaction & provide reason
Frontend -> Filter: POST /api/v1/disputes\n(Authorization: Bearer <JWT>, DisputeRequestDto)

Filter -> JWT: isTokenValid(jwt, userDetails)
alt #LightPink Token Invalid / Missing
    Filter --> Frontend: <font color=red><b>401 Unauthorized</b></font>
    Frontend --> Customer: Prompt login
else #LightGreen Token Valid
    Filter -> Controller: forward authenticated request
    Controller -> JWT: extractCustomerId(token)
    JWT --> Controller: customerId
    Controller -> Service: submitDispute(customerId, request)

    Service -> UserRepo: findById(customerId)
    UserRepo -> DB: SELECT ... FROM customers WHERE customer_id = ?
    DB --> UserRepo: UserEntity
    UserRepo --> Service: UserEntity

    Service -> TxnRepo: findById(request.transactionId())
    TxnRepo -> DB: SELECT ... FROM transactions WHERE transaction_id = ?
    DB --> TxnRepo: TransactionEntity
    TxnRepo --> Service: TransactionEntity

    alt #LightPink Transaction Not Owned by Customer
        Service --> Controller: throw UnauthorizedException\n(MSG_UNAUTHORIZED_TRANSACTION_ACCESS)
        Controller --> Frontend: <font color=red><b>401 Unauthorized</b> (ErrorResponseDto)</font>
        Frontend --> Customer: Show error message
    else #LightPink Duplicate Dispute Exists
        Service -> DisputeRepo: existsByTransactionTransactionId(transactionId)
        DisputeRepo --> Service: true
        Service --> Controller: throw BadRequestException\n(MSG_DISPUTE_ALREADY_EXISTS)
        Controller --> Frontend: <font color=red><b>400 Bad Request</b> (ErrorResponseDto)</font>
        Frontend --> Customer: Show error message
    else #LightGreen Valid & Eligible
        Service -> RiskEngine: calculate(transaction, reason)
        RiskEngine --> Service: riskScore (0-100)

        Service -> DecisionMatrix: evaluate(riskScore)
        DecisionMatrix --> Service: AUTO_APPROVE (<=50)\nor MANUAL_INVESTIGATION (>50)

        Service -> DisputeRepo: save(DisputeEntity)\n(status AUTO_APPROVED or QUEUED_FOR_AGENT)
        DisputeRepo -> DB: INSERT INTO disputes (dispute_seq)
        DB --> DisputeRepo: savedDispute (disputeReference)
        DisputeRepo --> Service: savedDispute

        Service -> SqsPublisher: publishDisputeEvent(savedDispute)
        SqsPublisher -> SQS: sendMessage(dispute event JSON)
        SQS --> SqsPublisher: sqsMessageId
        SqsPublisher --> Service: sqsMessageId
        Service -> DisputeRepo: save(dispute with sqsMessageId)
        DisputeRepo -> DB: UPDATE disputes SET sqs_message_id = ?

        Service --> Controller: DisputeResponseDto\n(disputeReference, riskScore, decisionRoute, status, message)
        Controller --> Frontend: <font color=green><b>201 Created</b> (DisputeResponseDto)</font>
        Frontend --> Customer: Show confirmation (dispute reference + outcome)
    end
end
@enduml
