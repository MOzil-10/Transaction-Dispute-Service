@startuml
title View Transactions
autonumber
skinparam Style strictuml
skinparam SequenceMessageAlignment center
skinparam boxPadding 10

box "User" #E6F0FA
actor "Customer" as Customer
end box

box "Client" #E6F9E6
participant "DisputeX Web App" as Frontend
end box

box "DisputeX Backend" #FFF9E6
participant "Auth Filter" as Filter
participant "DisputeX API" as Api
participant "Transaction Service" as Service
end box

box "Data" #F2E6FF
database "Account Store" as AccountDB
database "Transaction Store" as TxnDB
end box

Customer -> Frontend: Open transactions
Frontend -> Filter: Request transaction history\n(with access token)

Filter -> Filter: Verify access token
alt #LightPink Token invalid or expired
    Filter --> Frontend: Session expired
    Frontend --> Customer: Redirect to login
else #LightGreen Token valid
    Filter -> Api: Forward authenticated request
    Api -> Service: Get transactions for customer\n(page, size)

    Service -> AccountDB: Find customer's account
    AccountDB --> Service: Account

    alt #LightPink Account not found
        Service --> Api: Account not found
        Api --> Frontend: Not found error
        Frontend --> Customer: Show error message
    else #LightGreen Account found
        Service -> TxnDB: Fetch transactions\n(most recent first, paginated)
        TxnDB --> Service: Page of transactions
        Service --> Api: Transaction page\n(amount, merchant, category, mandate type, disputable)
        Api --> Frontend: Transactions returned
        Frontend --> Customer: Display transactions
    end
end
@enduml