@startuml
title View Dispute History
autonumber
skinparam Style strictuml
skinparam SequenceMessageAlignment center
skinparam boxPadding 10

box "User" #E6F0FA
actor "Customer" as Customer
end box

box "Client" #E6F9E6
participant "DisputeX Web App" as Frontend
end box

box "DisputeX Backend" #FFF9E6
participant "Auth Filter" as Filter
participant "DisputeX API" as Api
participant "Dispute Service" as Service
end box

box "Data" #F2E6FF
database "Customer Store" as CustomerDB
database "Dispute Store" as DisputeDB
end box

Customer -> Frontend: Open dispute history
Frontend -> Filter: Request dispute history\n(with access token)

Filter -> Filter: Verify access token
alt #LightPink Token expired or missing
    Filter --> Frontend: Session expired
    Frontend --> Customer: Prompt to log in
else #LightGreen Token valid
    Filter -> Api: Forward authenticated request
    Api -> Service: Get disputes for customer\n(page, size)

    Service -> CustomerDB: Confirm customer exists
    CustomerDB --> Service: Result

    alt #LightPink Customer not found
        Service --> Api: Customer not found
        Api --> Frontend: Not found error
        Frontend --> Customer: Show error message
    else #LightGreen Customer found
        Service -> DisputeDB: Fetch disputes\n(newest first, paginated)
        DisputeDB --> Service: Page of disputes
        Service --> Api: Dispute page\n(reference, reason, amount, status, decision route, opened date)
        Api --> Frontend: Disputes returned
        Frontend --> Customer: Display dispute history
    end
end
@enduml