@startuml
autonumber
skinparam Style strictuml
skinparam SequenceMessageAlignment center
skinparam boxPadding 10

box "User Layer" #E6F0FA
actor "Customer\n(Rita)" as Customer
end box

box "Frontend Layer" #E6F9E6
participant "Angular Frontend\n(Web App)" as Frontend
end box

box "API & Service Layer" #FFF9E6
participant "AuthController" as Controller
participant "AuthService" as Service
participant "UserRepository" as UserRepo
participant "PasswordEncoder\n(BCrypt)" as Encoder
participant "AccountRepository" as AccountRepo
participant "UserDetailsService" as UDS
participant "JwtService" as JWT
end box

box "Database Layer" #F2E6FF
database "PostgreSQL\n(RDS Database)" as DB
end box

Customer -> Frontend: Submit registration form (firstName, lastName, email, password)
Frontend -> Controller: POST /api/v1/auth/register\n(RegisterRequestDto)

Controller -> Service: register(request)
Service -> UserRepo: existsByEmail(request.email())
UserRepo -> DB: SELECT ... FROM customers WHERE email = ?
DB --> UserRepo: boolean
UserRepo --> Service: boolean

alt #LightPink Email Already Registered
    Service --> Controller: throw BadRequestException\n(MSG_EMAIL_ALREADY_EXISTS)
    Controller --> Frontend: <font color=red><b>400 Bad Request</b> (ErrorResponseDto)</font>
    Frontend --> Customer: Display registration error
else #LightGreen New Customer
    Service -> Encoder: encode(request.password())
    Encoder --> Service: passwordHash

    Service -> UserRepo: save(UserEntity)
    UserRepo -> DB: INSERT INTO customers (customer_seq)
    DB --> UserRepo: savedUser (customerId)
    UserRepo --> Service: savedUser

    Service -> AccountRepo: save(AccountEntity)\n(MAIN_ACCOUNT, ZAR 10,000.00 seed)
    AccountRepo -> DB: INSERT INTO accounts (account_seq)
    DB --> AccountRepo: savedAccount
    AccountRepo --> Service: savedAccount

    Service -> UDS: loadUserByUsername(savedUser.getEmail())
    UDS --> Service: UserDetails
    Service -> JWT: generateToken(userDetails, customerId)
    JWT --> Service: Bearer JWT (customerId claim)

    Service --> Controller: AuthResponseDto\n(token, customerId, email)
    Controller --> Frontend: <font color=green><b>201 Created</b> (AuthResponseDto)</font>
    Frontend --> Customer: Registration successful (redirect to dashboard)
end
@enduml
