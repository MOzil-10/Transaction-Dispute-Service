                                  {
                                      "name":  "Get Transactions - Trevor (check disputable flag)",
                                      "event":  [
                                                    {
                                                        "listen":  "test",
                                                        "script":  {
                                                                       "type":  "text/javascript",
                                                                       "exec":  [
                                                                                    "pm.test(\"200 OK\", () =\u003e pm.response.to.have.status(200));",
                                                                                    "var items = pm.response.json().content;",
                                                                                    "pm.test(\"each transaction exposes a disputable flag\", function () {",
                                                                                    "  items.forEach(t =\u003e pm.expect(t).to.have.property(\u0027disputable\u0027));",
                                                                                    "});",
                                                                                    "var pnp = items.find(t =\u003e t.transactionId === 2000003);",
                                                                                    "if (pnp) { pm.test(\"Pick n Pay (IN_STORE_RETAIL) is not disputable\", () =\u003e pm.expect(pnp.disputable).to.eql(false)); }",
                                                                                    "var tak = items.find(t =\u003e t.transactionId === 2000010);",
                                                                                    "if (tak) { pm.test(\"Takealot (ONLINE_RETAIL) is disputable\", () =\u003e pm.expect(tak.disputable).to.eql(true)); }"
                                                                                ]
                                                                   }
                                                    }
                                                ],
                                      "request":  {
                                                      "method":  "GET",
                                                      "header":  [
                                                                     {
                                                                         "key":  "Authorization",
                                                                         "value":  "Bearer {{trevorToken}}"
                                                                     }
                                                                 ],
